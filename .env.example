# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Settings → Environment Variables.

# --- Required ---
DATABASE_URL=
ANTHROPIC_API_KEY=

# --- Billing (Stripe). Checkout stays off until the first three are set. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
# The yearly option only appears when this is set.
STRIPE_PRICE_STARTER_YEARLY=
# "1" turns on Stripe Tax at checkout (enable Stripe Tax in the Stripe Dashboard first).
STRIPE_AUTOMATIC_TAX=

# --- Optional ---
# "Continue with Google" appears on login/signup only when both are set.
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URIs: https://sevrii.com/api/auth/google/callback
#   and https://www.sevrii.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email (password reset links). Resend.com API key; sender must be on a verified domain.
RESEND_API_KEY=
# Optional. Defaults to "Sevrii <hola@sevrii.com>".
EMAIL_FROM=
# Optional. Where replies to Sevrii emails go.
EMAIL_REPLY_TO=
# Optional. Stripe webhook for CONNECTED accounts (Payments), endpoint
# https://www.sevrii.com/api/stripe/connect, event checkout.session.completed.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Where Stripe sends people back after paying. Defaults to https://sevrii.com
SEVRII_SITE_URL=
# Comma-separated emails that get every feature (for testing).
SEVRII_ADMIN_EMAILS=
# Photo uploads in Store (Vercel Blob).
BLOB_READ_WRITE_TOKEN=
# Model overrides (defaults live in lib/claude.ts).
ANTHROPIC_MODEL=
SEVRII_MODEL_CHAT=
SEVRII_MODEL_RESEARCH=
SEVRII_MODEL_STRATEGY=
SEVRII_MODEL_GUARD=
