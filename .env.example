# Copy to .env.local for local development. Never commit real values.
# In production these are set in Vercel → Settings → Environment Variables.

# --- Required ---
DATABASE_URL=
ANTHROPIC_API_KEY=

# --- Billing (Stripe). Checkout stays off until the first three are set. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
# The yearly option only appears when this is set.
STRIPE_PRICE_STARTER_YEARLY=
# "1" turns on Stripe Tax at checkout (enable Stripe Tax in the Stripe Dashboard first).
STRIPE_AUTOMATIC_TAX=

# --- Optional ---
# Where Stripe sends people back after paying. Defaults to https://sevrii.com
SEVRII_SITE_URL=
# Comma-separated emails that get every feature (for testing).
SEVRII_ADMIN_EMAILS=
# Photo uploads in Store (Vercel Blob).
BLOB_READ_WRITE_TOKEN=
# Model overrides (defaults live in lib/claude.ts).
ANTHROPIC_MODEL=
SEVRII_MODEL_CHAT=
SEVRII_MODEL_RESEARCH=
SEVRII_MODEL_STRATEGY=
SEVRII_MODEL_GUARD=
